{
    "name": "vine-ui",
    "version": "3.1.18",
    "description": "vine ui components",
    "type": "module",
    "main": "dist/vine-ui.js",
    "exports": {
        ".": {
            "import": "./dist/vine-ui.esm.js",
            "types": "./dist/vine-ui.d.ts",
            "default": "./dist/vine-ui.js"
        },
        "./dist/*": "./dist/*"
    },
    "types": "dist/vine-ui.d.ts",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint src/ && stylelint src/**/*.scss",
        "docs": "vite build --mode docs",
        "preview": "vite preview --mode docs",
        "version": "npm run build",
        "publish": "node ./scripts/publish.js"
    },
    "files": [
        "dist"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cenfun/vine-ui.git"
    },
    "dependencies": {},
    "devDependencies": {
        "@babel/runtime": "^8.0.0",
        "@codemirror/view": "^6.43.7",
        "@lezer/common": "^1.5.2",
        "@lezer/css": "^1.3.4",
        "@lezer/html": "^1.3.13",
        "@lezer/javascript": "^1.5.4",
        "@uiw/codemirror-theme-vscode": "^4.25.11",
        "@vitejs/plugin-vue": "^6.0.8",
        "async-tick": "^1.0.2",
        "codemirror": "^6.0.2",
        "eight-colors": "^1.3.3",
        "eslint": "^10.8.0",
        "eslint-config-plus": "^2.0.4",
        "eslint-plugin-vue": "^10.10.0",
        "execa": "^10.0.1",
        "fps-detector": "^1.1.0",
        "monocart-coverage-reports": "^2.12.12",
        "popover-helper": "^3.0.2",
        "sass": "^1.102.0",
        "stylelint": "^17.14.1",
        "stylelint-config-plus": "^1.1.6",
        "vite": "^8.2.0",
        "vite-plugin-css-injected-by-js": "^5.0.2",
        "vue": "^3.5.40",
        "vue-docgen-api": "^4.79.2",
        "vue-router": "^5.2.0"
    }
}